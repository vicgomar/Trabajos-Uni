
limite = 2000000

primos = [True] * (limite + 1)

primos[0] = False
primos[1] = False

for i in range(2, int(limite ** 0.5) + 1):
    if primos[i]:
        for j in range(i * i, limite + 1, i):
            primos[j] = False

suma = 0

for i in range(2, limite + 1):
    if primos[i]:
        suma += i

print("La suma de los números primos es:", suma)
